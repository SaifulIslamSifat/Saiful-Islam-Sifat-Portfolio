# Copy to .env and fill in. NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (create a DB user with least privilege)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sifat-portfolio?retryWrites=true&w=majority

# Allowed frontend origins, comma-separated, no trailing slash (no wildcards)
CLIENT_ORIGIN=http://localhost:5173

# Random string used to hash visitor IPs before storage
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional: email notification on new contact messages. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
NOTIFY_FROM=
